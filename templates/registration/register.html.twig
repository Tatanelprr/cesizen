{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5">
        <div class="card p-4">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold">Créer un compte</h1>
                <p class="text-muted">Rejoignez CESIZen gratuitement</p>
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.pseudo, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.pseudo, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(form.pseudo) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(form.plainPassword.first) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(form.plainPassword) }}
                </div>
                <div class="mb-4">
                    <div class="form-check">
                        {{ form_widget(form.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.agreeTerms, null, {'label_attr': {'class': 'form-check-label small'}}) }}
                    </div>
                    {{ form_errors(form.agreeTerms) }}
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Créer mon compte</button>
            {{ form_end(form) }}

            <div class="text-center mt-3">
                <p class="mb-0">Déjà un compte ?
                    <a href="{{ path('app_login') }}" class="text-primary fw-semibold">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
