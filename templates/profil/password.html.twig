{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <a href="{{ path('app_profil') }}" class="btn btn-outline-primary btn-sm mb-4">
            <i class="bi bi-arrow-left"></i> Retour au profil
        </a>

        <div class="card p-4">
            <h1 class="h4 fw-bold mb-4">Changer le mot de passe</h1>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(form.newPassword.first) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(form.newPassword) }}
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Modifier</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
