{% extends 'base.html.twig' %}
{% block title %}Activités de détente{% endblock %}
{% block body %}
<h1 class="h3 fw-bold mb-4">Activités de détente</h1>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="{{ path('app_activity_index') }}"
       class="btn btn-sm {{ selectedType == '' ? 'btn-primary' : 'btn-outline-primary' }}">Toutes</a>
    {% for type in types %}
    <a href="{{ path('app_activity_index', {type: type}) }}"
       class="btn btn-sm {{ selectedType == type ? 'btn-primary' : 'btn-outline-primary' }}">
        {{ type|capitalize }}
    </a>
    {% endfor %}
</div>

{% if activities|length == 0 %}
    <div class="text-center py-5 text-muted">
        <i class="bi bi-tree fs-1"></i>
        <p class="mt-2">Aucune activité disponible.</p>
    </div>
{% else %}
    <div class="row g-3">
        {% for activity in activities %}
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-secondary">{{ activity.type|capitalize }}</span>
                </div>
                <h5 class="fw-bold">{{ activity.titre }}</h5>
                <p class="text-muted small flex-grow-1">{{ activity.description|slice(0, 120) }}…</p>
                <a href="{{ path('app_activity_show', {id: activity.id}) }}"
                   class="btn btn-outline-primary btn-sm mt-2">Découvrir</a>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
