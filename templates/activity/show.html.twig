{% extends 'base.html.twig' %}
{% block title %}{{ activity.titre }}{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <a href="{{ path('app_activity_index') }}" class="btn btn-outline-primary btn-sm mb-4">
            <i class="bi bi-arrow-left"></i> Retour
        </a>

        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <span class="badge bg-secondary">{{ activity.type|capitalize }}</span>
                {% if is_granted('ROLE_USER') %}
                <form method="post" action="{{ path('app_activity_toggle_favorite', {id: activity.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('favorite-' ~ activity.id) }}">
                    <button type="submit" class="btn btn-sm {{ isFavorite ? 'btn-warning' : 'btn-outline-warning' }}">
                        <i class="bi bi-star{{ isFavorite ? '-fill' : '' }}"></i>
                        {{ isFavorite ? 'Favori' : 'Ajouter aux favoris' }}
                    </button>
                </form>
                {% endif %}
            </div>

            <h1 class="h3 fw-bold mb-3">{{ activity.titre }}</h1>
            <p style="line-height: 1.8;">{{ activity.description|nl2br }}</p>

            {% if activity.urlMedia %}
            <div class="mt-4">
                {% if 'youtube.com' in activity.urlMedia or 'youtu.be' in activity.urlMedia %}
                    {% set videoId = activity.urlMedia|split('v=')|last|split('&')|first %}
                    <div class="ratio ratio-16x9 rounded overflow-hidden">
                        <iframe src="https://www.youtube.com/embed/{{ videoId }}"
                                allowfullscreen></iframe>
                    </div>
                {% elseif 'vimeo.com' in activity.urlMedia %}
                    {% set videoId = activity.urlMedia|split('vimeo.com/')|last %}
                    <div class="ratio ratio-16x9 rounded overflow-hidden">
                        <iframe src="https://player.vimeo.com/video/{{ videoId }}"
                                allowfullscreen></iframe>
                    </div>
                {% else %}
                    <a href="{{ activity.urlMedia }}" target="_blank" class="btn btn-primary">
                        <i class="bi bi-play-circle"></i> Accéder au contenu
                    </a>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
