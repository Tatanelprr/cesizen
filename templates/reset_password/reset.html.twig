{% extends 'base.html.twig' %}
{% block title %}Nouveau mot de passe{% endblock %}
{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5">
        <div class="card p-4">
            <h1 class="h4 fw-bold mb-4">Choisissez un nouveau mot de passe</h1>
            {{ form_start(resetForm) }}
                <div class="mb-3">
                    {{ form_label(resetForm.newPassword.first, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(resetForm.newPassword.first, {'attr': {'class': 'form-control form-control-lg'}}) }}
                </div>
                <div class="mb-4">
                    {{ form_label(resetForm.newPassword.second, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(resetForm.newPassword.second, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(resetForm.newPassword) }}
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Réinitialiser</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
</div>
{% endblock %}
