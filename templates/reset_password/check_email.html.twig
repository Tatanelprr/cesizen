{% extends 'base.html.twig' %}
{% block title %}Email envoyé{% endblock %}
{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5">
        <div class="card p-4 text-center">
            <i class="bi bi-envelope-check fs-1 text-primary mb-3"></i>
            <h1 class="h4 fw-bold">Email envoyé !</h1>
            <p class="text-muted">Un lien de réinitialisation a été envoyé à votre adresse email. Il est valable <strong>1 heure</strong>.</p>
            <p class="text-muted small">Si vous ne recevez rien, vérifiez vos spams.</p>
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary mt-2">Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
