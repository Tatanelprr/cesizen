{% extends 'base.html.twig' %}

{% block title %}Signaler un problème / Suggérer une idée{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card p-4">
            <div class="mb-4">
                <h1 class="h4 fw-bold mb-1">
                    <i class="bi bi-flag text-primary me-2"></i>Signaler un problème / Suggérer une idée
                </h1>
                <p class="text-muted small mb-0">Votre retour est transmis directement à l'équipe de développement.</p>
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="mb-3">
                    {{ form_label(form.type, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.type) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.email) }}
                    <div class="form-text">Laissez vide si vous ne souhaitez pas être recontacté(e).</div>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-send me-1"></i>Envoyer
                </button>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
