{% extends 'base.html.twig' %}

{% block title %}S'informer{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 fw-bold mb-0">S'informer</h1>
</div>

<div class="mb-4 d-flex flex-wrap gap-2">
    <a href="{{ path('app_information_index') }}"
       class="btn btn-sm {{ selectedCategoryId == 0 ? 'btn-primary' : 'btn-outline-primary' }}">
        Tous
    </a>
    {% for category in categories %}
        <a href="{{ path('app_information_index', {categorie: category.id}) }}"
           class="btn btn-sm {{ selectedCategoryId == category.id ? 'btn-primary' : 'btn-outline-primary' }}">
            {{ category.name }}
        </a>
    {% endfor %}
</div>

{% if articles|length == 0 %}
    <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x fs-1"></i>
        <p class="mt-2">Aucun article disponible pour le moment.</p>
    </div>
{% else %}
    <div class="row g-3">
        {% for article in articles %}
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 p-3">
                {% if article.category %}
                    <span class="badge badge-zen mb-2 align-self-start">{{ article.category.name }}</span>
                {% endif %}
                <h5 class="fw-bold">{{ article.title }}</h5>
                <p class="text-muted small flex-grow-1">
                    {{ article.content|striptags|slice(0, 150) }}…
                </p>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-muted">
                        {{ article.publishedAt ? article.publishedAt|date('d/m/Y') : '' }}
                    </small>
                    <a href="{{ path('app_information_show', {slug: article.slug}) }}"
                       class="btn btn-outline-primary btn-sm">Lire</a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
