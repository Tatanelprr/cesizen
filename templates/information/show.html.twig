{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <a href="{{ path('app_information_index') }}" class="btn btn-outline-primary btn-sm mb-4">
            <i class="bi bi-arrow-left"></i> Retour aux articles
        </a>

        <article class="card p-4">
            {% if article.category %}
                <span class="badge badge-zen mb-3 align-self-start">{{ article.category.name }}</span>
            {% endif %}

            <h1 class="h2 fw-bold mb-2">{{ article.title }}</h1>

            <p class="text-muted small mb-4">
                Publié le {{ article.publishedAt|date('d/m/Y') }}
            </p>

            <div class="article-content" style="line-height: 1.8; font-size: 1rem;">
                {{ article.content|nl2br }}
            </div>
        </article>
    </div>
</div>
{% endblock %}
