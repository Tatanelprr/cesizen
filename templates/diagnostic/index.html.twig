{% extends 'base.html.twig' %}
{% block title %}Diagnostic de stress{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <h1 class="h3 fw-bold mb-1">Diagnostic de stress</h1>
        <p class="text-muted mb-4">Cochez les événements que vous avez vécus au cours des <strong>12 derniers mois</strong>.</p>

        <form method="post" action="{{ path('app_diagnostic_result') }}">
            <div class="d-flex flex-column gap-2 mb-4">
                {% for event in events %}
                <label class="card p-3 d-flex flex-row align-items-center gap-3" style="cursor:pointer;">
                    <input type="checkbox" name="events[]" value="{{ event.id }}"
                           class="form-check-input flex-shrink-0" style="width:1.3rem;height:1.3rem;">
                    <div class="flex-grow-1">{{ event.libelle }}</div>
                    <span class="badge bg-primary">{{ event.points }} pts</span>
                </label>
                {% else %}
                <div class="text-center text-muted py-4">Aucun événement configuré.</div>
                {% endfor %}
            </div>
            {% if events|length > 0 %}
            <button type="submit" class="btn btn-primary btn-lg w-100">Calculer mon score</button>
            {% endif %}
        </form>
    </div>
</div>
{% endblock %}
