{% extends 'base.html.twig' %}
{% block title %}Seuil de résultat{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <a href="{{ path('app_admin_diagnostic_index') }}" class="btn btn-outline-primary btn-sm mb-4">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <div class="card p-4">
            <h1 class="h4 fw-bold mb-4">Configurer un seuil de résultat</h1>
            {{ form_start(form) }}
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        {{ form_label(form.scoreMin, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.scoreMin, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-6">
                        {{ form_label(form.scoreMax, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.scoreMax, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.niveau, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.niveau, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.codeColor, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.codeColor, {'attr': {'class': 'form-control form-control-color'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.conseil, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.conseil, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                </div>
                <button type="submit" class="btn btn-primary w-100">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
