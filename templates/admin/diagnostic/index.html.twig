{% extends 'base.html.twig' %}
{% block title %}Gestion du diagnostic{% endblock %}
{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-primary btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
        <h1 class="h3 fw-bold mb-0">Questionnaire de stress</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_admin_diagnostic_threshold_new') }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Seuil de résultat
        </a>
        <a href="{{ path('app_admin_diagnostic_event_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Événement
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-header fw-bold">Événements ({{ events|length }})</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Événement</th><th>Points</th><th>Statut</th><th></th></tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                        <tr>
                            <td>{{ event.libelle }}</td>
                            <td><span class="badge bg-primary">{{ event.points }}</span></td>
                            <td>
                                <span class="badge {{ event.isActive ? 'bg-success' : 'bg-secondary' }}">
                                    {{ event.isActive ? 'Actif' : 'Inactif' }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="{{ path('app_admin_diagnostic_event_edit', {id: event.id}) }}"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_admin_diagnostic_event_delete', {id: event.id}) }}"
                                          onsubmit="return confirm('Supprimer ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-event-' ~ event.id) }}">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-header fw-bold">Seuils de résultat</div>
            <div class="d-flex flex-column gap-2 p-3">
                {% for threshold in thresholds %}
                <div class="p-3 rounded" style="border-left: 4px solid {{ threshold.codeColor }}; background: {{ threshold.codeColor }}11">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">{{ threshold.niveau }}</div>
                            <div class="small text-muted">{{ threshold.scoreMin }} – {{ threshold.scoreMax }} pts</div>
                        </div>
                        <div class="d-flex gap-1">
                            <a href="{{ path('app_admin_diagnostic_threshold_edit', {id: threshold.id}) }}"
                               class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        </div>
                    </div>
                </div>
                {% else %}
                <p class="text-muted text-center py-2">Aucun seuil configuré.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
