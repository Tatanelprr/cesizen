{% extends 'base.html.twig' %}
{% block title %}Gestion des activités{% endblock %}
{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-primary btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
        <h1 class="h3 fw-bold mb-0">Activités de détente</h1>
    </div>
    <a href="{{ path('app_admin_activity_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nouvelle activité
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Titre</th><th>Type</th><th>Statut</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {% for activity in activities %}
                <tr>
                    <td class="fw-semibold">{{ activity.titre }}</td>
                    <td><span class="badge bg-secondary">{{ activity.type|capitalize }}</span></td>
                    <td>
                        <span class="badge {{ activity.isActive ? 'bg-success' : 'bg-secondary' }}">
                            {{ activity.isActive ? 'Active' : 'Inactive' }}
                        </span>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('app_admin_activity_edit', {id: activity.id}) }}"
                               class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="{{ path('app_admin_activity_toggle', {id: activity.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-activity-' ~ activity.id) }}">
                                <button class="btn btn-sm {{ activity.isActive ? 'btn-outline-warning' : 'btn-outline-success' }}">
                                    {{ activity.isActive ? 'Désactiver' : 'Activer' }}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-muted py-4">Aucune activité.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
