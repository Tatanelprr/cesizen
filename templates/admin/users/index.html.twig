{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-primary btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
        <h1 class="h3 fw-bold mb-0">Utilisateurs</h1>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Pseudo</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Inscription</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td class="fw-semibold">{{ user.pseudo }}</td>
                    <td class="text-muted small">{{ user.email }}</td>
                    <td>
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="badge" style="background:var(--cz-yellow);color:var(--cz-dark)">Admin</span>
                        {% else %}
                            <span class="badge bg-secondary">Utilisateur</span>
                        {% endif %}
                    </td>
                    <td class="small text-muted">{{ user.createdAt|date('d/m/Y') }}</td>
                    <td>
                        {% if user.isActive %}
                            <span class="badge bg-success">Actif</span>
                        {% else %}
                            <span class="badge bg-danger">Désactivé</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if user != app.user %}
                        <div class="d-flex gap-1">
                            <form method="post" action="{{ path('app_admin_user_toggle', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-user-' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm {{ user.isActive ? 'btn-outline-warning' : 'btn-outline-success' }}">
                                    {{ user.isActive ? 'Désactiver' : 'Activer' }}
                                </button>
                            </form>
                            <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                                  onsubmit="return confirm('Supprimer définitivement ce compte ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                        {% else %}
                            <span class="text-muted small">Vous</span>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Aucun utilisateur.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
