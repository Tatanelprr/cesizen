{% extends 'base.html.twig' %}

{% block title %}{{ article.id ? 'Modifier' : 'Nouvel' }} article{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <a href="{{ path('app_admin_articles') }}" class="btn btn-outline-primary btn-sm mb-4">
            <i class="bi bi-arrow-left"></i> Retour aux articles
        </a>

        <div class="card p-4">
            <h1 class="h4 fw-bold mb-4">
                {{ article.id ? 'Modifier l\'article' : 'Nouvel article' }}
            </h1>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    {{ form_errors(form.title) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.category, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.content, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows': 14}}) }}
                    {{ form_errors(form.content) }}
                </div>
                <div class="mb-4 form-check">
                    {{ form_widget(form.isPublished, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.isPublished, null, {'label_attr': {'class': 'form-check-label fw-semibold'}}) }}
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    {{ article.id ? 'Enregistrer les modifications' : 'Créer l\'article' }}
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
