{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie d'émotions{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <a href="{{ path('app_admin_emotions') }}" class="btn btn-outline-primary btn-sm mb-4">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <div class="card p-4">
            <h1 class="h4 fw-bold mb-4">Nouvelle catégorie</h1>
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.libelle, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.libelle, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.codeColor, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.codeColor, {'attr': {'class': 'form-control form-control-color'}}) }}
                </div>
                <button type="submit" class="btn btn-primary w-100">Créer</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
