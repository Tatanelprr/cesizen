{% extends 'base.html.twig' %}

{% block title %}Rapport d'émotions{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 fw-bold mb-0">Rapport d'émotions</h1>
    <a href="{{ path('app_tracker_index') }}" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-left"></i> Journal
    </a>
</div>

<div class="d-flex gap-2 mb-4 flex-wrap">
    {% for key, label in {semaine: 'Cette semaine', mois: 'Ce mois', trimestre: 'Trimestre', annee: 'Année'} %}
        <a href="{{ path('app_tracker_report', {periode: key}) }}"
           class="btn btn-sm {{ period == key ? 'btn-primary' : 'btn-outline-primary' }}">
            {{ label }}
        </a>
    {% endfor %}
</div>

{% if entries|length == 0 %}
    <div class="text-center py-5 text-muted">
        <i class="bi bi-bar-chart fs-1"></i>
        <p class="mt-2">Aucune donnée sur cette période.</p>
    </div>
{% else %}
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="card p-3">
                <h6 class="fw-bold mb-3">Répartition par émotion de base</h6>
                <canvas id="doughnutChart" height="250"></canvas>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card p-3">
                <h6 class="fw-bold mb-3">Intensité moyenne par catégorie</h6>
                <canvas id="barChart" height="250"></canvas>
            </div>
        </div>
    </div>

    <div class="card p-3">
        <h6 class="fw-bold mb-3">
            {{ entries|length }} entrée{{ entries|length > 1 ? 's' : '' }} —
            du {{ from|date('d/m/Y') }} au {{ to|date('d/m/Y') }}
        </h6>
        <div class="d-flex flex-column gap-2">
            {% for entry in entries %}
            <div class="d-flex align-items-center justify-content-between p-2 rounded"
                 style="background: {{ entry.emotion.codeColor }}11; border-left: 3px solid {{ entry.emotion.codeColor }}">
                <div>
                    <span class="fw-semibold">{{ entry.emotion.libelle }}</span>
                    <small class="text-muted ms-2">{{ entry.emotion.category.libelle }}</small>
                    {% if entry.notePerso %}
                        <p class="mb-0 small fst-italic text-muted mt-1">"{{ entry.notePerso }}"</p>
                    {% endif %}
                </div>
                <div class="text-end">
                    <div class="badge" style="background:{{ entry.emotion.codeColor }}">{{ entry.intensite }}/10</div>
                    <div class="small text-muted mt-1">{{ entry.dateCreation|date('d/m à H:i') }}</div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
{% if entries|length > 0 %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    const chartData = {{ chartData|json_encode|raw }};

    new Chart(document.getElementById('doughnutChart'), {
        type: 'doughnut',
        data: {
            labels: chartData.labels,
            datasets: [{
                data: chartData.data,
                backgroundColor: chartData.colors.map(c => c + 'CC'),
                borderColor: chartData.colors,
                borderWidth: 2,
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: chartData.labels,
            datasets: [{
                label: 'Nombre d\'entrées',
                data: chartData.data,
                backgroundColor: chartData.colors.map(c => c + 'AA'),
                borderColor: chartData.colors,
                borderWidth: 2,
                borderRadius: 8,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
        }
    });
</script>
{% endif %}
{% endblock %}
