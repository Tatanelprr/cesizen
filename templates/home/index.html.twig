{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<section class="pt-3 pb-5 text-center">
    <img src="{{ asset('images/logo.png') }}" alt="CESIZen" style="height: 120px; margin-bottom: 12px;">
    <p class="lead text-muted mb-4">L'application de votre santé mentale</p>
    {% if not is_granted('ROLE_USER') %}
        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg me-2">Commencer</a>
        <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg">Se connecter</a>
    {% else %}
        <a href="{{ path('app_tracker_index') }}" class="btn btn-primary btn-lg">Mon tracker d'émotions</a>
    {% endif %}
</section>

<section class="row g-3 mb-5">
    <div class="col-12 col-md-4">
        <div class="card h-100 p-3 text-center">
            <i class="bi bi-journal-text fs-1 text-primary mb-2"></i>
            <h5 class="fw-bold">S'informer</h5>
            <p class="text-muted small">Accédez à des ressources vérifiées sur la santé mentale.</p>
            <a href="{{ path('app_information_index') }}" class="btn btn-outline-primary btn-sm mt-auto">Lire les articles</a>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 p-3 text-center">
            <i class="bi bi-clipboard2-pulse fs-1 text-primary mb-2"></i>
            <h5 class="fw-bold">Diagnostic</h5>
            <p class="text-muted small">Évaluez votre niveau de stress avec l'échelle Holmes & Rahe.</p>
            <a href="{{ path('app_diagnostic_index') }}" class="btn btn-outline-primary btn-sm mt-auto">Faire le test</a>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 p-3 text-center">
            <i class="bi bi-wind fs-1 text-primary mb-2"></i>
            <h5 class="fw-bold">Respiration</h5>
            <p class="text-muted small">Pratiquez la cohérence cardiaque pour réduire votre stress.</p>
            <a href="{{ path('app_breathing') }}" class="btn btn-outline-primary btn-sm mt-auto">Démarrer</a>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 p-3 text-center">
            <i class="bi bi-tree fs-1 text-primary mb-2"></i>
            <h5 class="fw-bold">Activités de détente</h5>
            <p class="text-muted small">Découvrez des activités pour vous ressourcer au quotidien.</p>
            <a href="{{ path('app_activity_index') }}" class="btn btn-outline-primary btn-sm mt-auto">Explorer</a>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 p-3 text-center">
            <i class="bi bi-heart-pulse fs-1 text-primary mb-2"></i>
            <h5 class="fw-bold">Tracker d'émotions</h5>
            <p class="text-muted small">Suivez votre état émotionnel et visualisez vos tendances.</p>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_tracker_index') }}" class="btn btn-outline-primary btn-sm mt-auto">Mon journal</a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-outline-primary btn-sm mt-auto">Créer un compte</a>
            {% endif %}
        </div>
    </div>
</section>

{% if articles|length > 0 %}
<section>
    <h2 class="h4 fw-bold mb-3">Derniers articles</h2>
    <div class="row g-3">
        {% for article in articles %}
        <div class="col-12 col-md-4">
            <div class="card h-100 p-3">
                {% if article.category %}
                    <span class="badge badge-zen mb-2">{{ article.category.name }}</span>
                {% endif %}
                <h6 class="fw-bold">{{ article.title }}</h6>
                <p class="text-muted small">{{ article.content|striptags|slice(0, 120) }}...</p>
                <a href="{{ path('app_information_show', {slug: article.slug}) }}" class="btn btn-outline-primary btn-sm mt-auto">Lire</a>
            </div>
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}
{% endblock %}
